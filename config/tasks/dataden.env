# Settings the dataden task reads. Only the names live here; set the values in
# config/rpi-setup.env (see config/rpi-setup.env.example for defaults and
# help). setup.sh splits that file into config/local/dataden.env before running.
DATADEN_DOMAIN=
DATADEN_VM=
DATADEN_VM_PORT=
DATADEN_VM_FINGERPRINT=
DATADEN_EMAIL=
DATADEN_IMAGE=
