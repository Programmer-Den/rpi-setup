# Settings the gateway task reads. Only the names live here; set the values in
# config/rpi-setup.env (see config/rpi-setup.env.example for defaults and
# help). setup.sh splits that file into config/local/gateway.env before running.
GATEWAY_DOMAIN=
GATEWAY_UPSTREAM=
GATEWAY_UPSTREAM_PORT=
GATEWAY_UPSTREAM_NAME=
GATEWAY_UPSTREAM_FINGERPRINT=
GATEWAY_EMAIL=
GATEWAY_IMAGE=
